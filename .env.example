# ============================================================
#  INTEGRAÇÃO DATACRAZY x OPERADORAS (Claro / TIM / Nio)
#  Copie para ".env" e preencha. NUNCA suba o .env ao git.
# ============================================================

PORT=3000
WEBHOOK_SECRET=troque-por-um-segredo-forte

# Operadoras ativas (comece só com claro; depois "claro,tim,nio")
PROVIDERS=claro

# ---- DataCrazy ----
DATACRAZY_TOKEN=
DATACRAZY_BASE_URL=https://api.g1.datacrazy.io
TRIGGER_STAGE_NAME=Análise de Crédito

# Campos adicionais — pode usar o NOME do campo (como aparece no DataCrazy) ou o id.
# Entrada (dados do cliente):
FIELD_ID_NOME=Nome Lead
FIELD_ID_CPF=CPF Lead
FIELD_ID_NASCIMENTO=Nascimento Lead
# Retorno (um por operadora):
FIELD_ID_CLARO_APROVADO=Claro Aprovado
FIELD_ID_TIM_APROVADO=Tim Aprovado
FIELD_ID_NIO_APROVADO=Nio Aprovado

# Navegador headless (true em produção; vira false automaticamente nos testes/login)
HEADLESS=true

# ---- Claro Conexão ----
CLARO_BASE_URL=https://app.conexaoclarobrasil.com.br
CLARO_TIPO_SERVICO=COM CABO
CLARO_ESTADO=RIO DE JANEIRO
CLARO_CIDADE=RIO DE JANEIRO
CLARO_CEP=22790-410
CLARO_NUMERO=40
CLARO_TIPO_CLIENTE=PESSOA FISICA
CLARO_TIPO_VENDA=
CLARO_TIPO_CONSULTA=CPF
CLARO_STORAGE_STATE=./data/claro-session.json
# Autologin headless (guarde como SECRET). Com isso o serviço loga sozinho, sem login diário manual.
CLARO_EMAIL=
CLARO_SENHA=

# ---- TIM (preencher quando for implementar) ----
TIM_BASE_URL=
TIM_LOGIN_URL=
TIM_STORAGE_STATE=./data/tim-session.json

# ---- Nio (preencher quando for implementar) ----
NIO_BASE_URL=
NIO_LOGIN_URL=
NIO_STORAGE_STATE=./data/nio-session.json
